      function lvRenderCustomLogCheckboxes(scope) {
        var $list    = $('#lv' + scope + 'CustomLogsList');
        var $actions = $('#lv' + scope + 'CustomActions');
        var $empty   = $('#lv' + scope + 'CustomEmpty');
        if (!$list.length) return;

        var enabledRaw = String($('#lv' + scope + 'EnabledCustomLogs').val() || '');
        var enabledSet = lvCsvToSet(enabledRaw);

        var defs = [];
        _lvCustomPaths.forEach(function(e) {
          if (!e || !e.label || !e.path) return;
          var slug = lvCustomSlug(e.label);
          if (!slug) return;
          defs.push({ key: 'custom:' + slug, name: e.label, path: e.path });
        });

        if (defs.length === 0) {
          $list.empty();
          $actions.hide();
          $empty.show();
          return;
        }
        $empty.hide();

        var html = '';
        defs.forEach(function(d) {
          var checked = !!enabledSet[d.key];
          var info    = (_lvCustomSourceInfo && _lvCustomSourceInfo[d.key]) || null;
          var size    = info ? (parseInt(info.size, 10) || 0) : 0;
          var missing = info && !info.exists;
          var status  = missing ? '<span class="lv-source-status"><span class="lv-status-dot stopped"></span>not found</span>' : '';

          html += lvRenderSourceRow(d.key, d.name, d.path, size, checked, false, status);
        });
        $list.html(html);
        $actions.css('display', 'flex');
      }

