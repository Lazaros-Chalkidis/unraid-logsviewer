    }
  }

  $customPathsRaw = (string)($lv_post['CUSTOM_PATHS_JSON'] ?? '');
  if ($customPathsRaw !== '') {
    $allowedPrefixes = ['/var/log/', '/mnt/user/', '/mnt/cache/'];
    $rawArr = @json_decode($customPathsRaw, true);
    if (is_array($rawArr)) {
      $valid = [];
      $seen  = [];
      foreach ($rawArr as $e) {
        if (!is_array($e)) continue;
        $label = trim((string)($e['label'] ?? ''));
        $path  = trim((string)($e['path']  ?? ''));
        if ($label === '' || $path === '') continue;
        if ($path[0] !== '/') $path = '/' . $path;
        if (strpos($path, '..') !== false) continue;
        $okPrefix = false;
        foreach ($allowedPrefixes as $p) { if (strpos($path, $p) === 0) { $okPrefix = true; break; } }
        if (!$okPrefix) continue;
        $slug = strtolower(preg_replace('/[^a-z0-9]+/', '-', strtolower($label)));
        $slug = trim((string)$slug, '-');
        if ($slug === '' || isset($seen[$slug])) continue;
        $seen[$slug] = true;
        $valid[] = ['label' => $label, 'path' => $path];
      }
      $_json = json_encode($valid, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
      if ($_json !== false) LogsViewerEndpoint::writeIfChanged('/boot/config/plugins/logsviewer/custom-paths.json', $_json, '[]');
    }
  }

