      function lvSyncScopedInputs(scope) {
        [['System', 'SystemLogs'], ['Docker', 'DockerContainers'], ['Vm', 'Vms'], ['Script', 'UserScripts'], ['Custom', 'CustomLogs']].forEach(function(c) {
          var $list = $('#lv' + scope + c[0] + 'LogsList');
          if (c[0] !== 'Custom' && !$list.data('lvListed')) return;
          var keys = [];
          $list.find('.lv-source-check:checked').each(function(){ keys.push(this.getAttribute('data-key')); });
          $('#lv' + scope + 'Enabled' + c[1]).val(keys.join(','));
