$lv_tog = static function($name, $cfg, $default = '0', $on = 'Enabled', $off = 'Disabled') {
  $v = ($cfg[$name] ?? $default) === '1';
  $cls = $v ? 'on' : 'off';
  $txt = $v ? $on : $off;
  return '<label class="lv-toggle"><input type="hidden" name="' . htmlspecialchars($name) . '" value="0"><input type="checkbox" name="' . htmlspecialchars($name) . '" value="1"' . ($v ? ' checked' : '') . '><span class="lv-toggle-track"></span></label><span class="lv-toggle-txt ' . $cls . '">' . $txt . '</span>';
};

$lv_options = static function(string $key, $cfg) use ($lv_selects, $lv_pick) {
  $cur = $lv_pick($key, $cfg[$key] ?? null);
  $html = '';
  foreach ($lv_selects[$key][1] as $v => $label) {
    $html .= '<option value="' . htmlspecialchars((string)$v) . '"' . ((string)$v === $cur ? ' selected' : '') . '>' . htmlspecialchars($label) . '</option>';
  }
  return $html;
};

