        function validBackupPath(path) {
          path = path.trim().replace(/\/+$/, '');
          if (path.indexOf('/mnt/user/') !== 0 || /[\x00-\x1f\x7f,"<>\\]|\$\{|&#?\w+;/.test(path)) return false;
          return path.slice(10).split('/').every(function(name) {
            return name !== '' && name !== '.' && name !== '..' && name === name.trim();
          });
        }

        function ajaxSubmitForm(e) {
          if (e) e.preventDefault();

          var bad = lvFindBadCustomPath();
          if (bad) {
            lvNotice('Not saved', bad.message, function() { lvFocusCustomPath(bad.index, bad.field); });
            return;
          }

          var storage = document.getElementById('lvBackupStorage');
          if (storage.value !== storage.defaultValue && !validBackupPath(storage.value)) {
            lvNotice('Not saved', 'The backup storage location is not valid. It must be a folder under /mnt/user/. Folder names cannot be "." or "..", start or end with a space, or contain a comma, a double quote, <, >, a backslash, ${ or an HTML entity such as &amp;.', function() {
              if (!isBackupTabActive()) document.getElementById('lvTabBackup').click();
              storage.closest('.lv-sec').classList.remove('closed');
              storage.focus();
            });
            return;
          }

          setBusy(true);
          lvFindBadRegex(function(row) {
            if (!row) return sendForm();
            setBusy(false);
            lvNotice('Not saved', 'The regex in alert rule "' + lvShort(row.querySelector('.lv-alert-rule-name').value.trim() || 'Unnamed') +
